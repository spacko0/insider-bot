# InsiderBot
# Copy to .env and edit. This bot reads only this file.

# --- IRC ---
# With IRC_USE_ZNC=true, set IRC_SERVER to the bouncer hostname
# (or set ZNC_SERVER / ZNC_HOST). Nothing is read from another project.
IRC_SERVER=irc.example.org
IRC_PORT=6667
IRC_NICKNAME=InsiderBot
IRC_CHANNELS=#insiders
# #channel or #channel:min_tier. Empty uses IRC_CHANNELS.
# Tiers: torrent_moderators, moderators, admin, team_leaders, coder, owner
# Aliases: mods, admin, bot_users, and the other short names in utils/config.py.
IRC_COMMAND_CHANNELS=#insiders
# Optional per-channel command allowlist. Example:
# IRC_CHANNEL_ALLOWED_COMMANDS=#insiders:news,addnews,banned,banuser,register,help
IRC_CHANNEL_ALLOWED_COMMANDS=
COMMAND_PREFIX=.
IRC_COLORS=true

AUTO_JOIN_CHANNELS=true
AUTO_IDENTIFY=true
NICKSERV_PASSWORD=

IRC_USE_SASL=false
SASL_ACCOUNT=
SASL_PASSWORD=
IRC_TLS=false
IRC_TLS_VERIFY=true
IRC_DEBUG=false
IRC_WELCOME_TIMEOUT=90
IRC_HEALTH_MONITOR=true
IRC_ACTIVITY_TIMEOUT=900
IRC_HEALTH_CHECK_INTERVAL=60
IRC_STALLED_REGISTRATION_SECONDS=120
# Blank follows ZNC: client PINGs are on when IRC_USE_ZNC=true.
IRC_CLIENT_PING=
IRC_CLIENT_PING_INTERVAL=120
IRC_CLIENT_PING_TIMEOUT=15
IRC_RECONNECT_DELAY=30
IRC_MAX_RECONNECT_ATTEMPTS=10
IRC_RECONNECT_ON_SEND_FAILURE=true
# This bot never sends a bouncer "connect" command.

# ZNC: do not combine with SASL. USER is the bouncer login; NICK is the IRC nick.
# Settings come only from this file. A blank IRC_NICKNAME uses ZNC_IRC_NICK.
IRC_USE_ZNC=false
ZNC_PASSWORD=
ZNC_USERNAME=
ZNC_USER=
ZNC_NETWORK=
ZNC_IRC_NICK=

IRC_BURST_MAX_LINES=8
IRC_BURST_PAUSE_SECONDS=10
LOG_LEVEL=INFO

# --- Who can run bot commands ---
# Anyone in these lists is a bot user. Admin and above can see .registered.
BOT_OWNER=
OWNER_USERS=
CODER=
TEAM_LEADERS=
ADMIN_GROUP=
MODERATORS=
TORRENT_MODERATORS=
# Extra nicks that may use member commands without being on a staff list.
BOT_USERS=
ADMIN_USERS=
STAFF_USERS=

# --- Lists ---
DATABASE_PATH=data/insider.db
NEWS_DEFAULT_LIMIT=8
NEWS_MAX_LIMIT=25
